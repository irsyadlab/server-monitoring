{
  "name": "@irsyadulibad/servermon",
  "version": "1.2.5",
  "description": "Lightweight server monitoring daemon — collects system metrics and sends structured reports to Telegram. Built with Bun + TypeScript.",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "servermon": "bin.js"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun index.ts",
    "build": "bun build --compile index.ts --outfile server-monitor",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/bun": "latest",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@crustjs/core": "^0.0.19",
    "@crustjs/plugins": "^0.1.2",
    "@elysiajs/html": "^1.4.2",
    "elysia": "^1.4.29"
  }
}
